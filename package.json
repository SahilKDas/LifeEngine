{
  "name": "life-engine-nnue",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cpp:configure": "cmake -S cpp -B build/cpp -DCMAKE_BUILD_TYPE=Release",
    "cpp:build": "cmake --build build/cpp --config Release",
    "cpp:test": "ctest --test-dir build/cpp -C Release --output-on-failure",
    "train": "build\\cpp\\life_train.exe public\\trained-brain.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
